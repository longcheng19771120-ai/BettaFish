# ==============================================================
#  BettaFish 完全本地化部署配置（配合 docker-compose.local.yml 使用）
#  使用方法：cp .env.local.example .env
#  说明文档：docs/local-deployment.md
# ==============================================================

# ====================== BETTAFISH 相关 ======================
HOST=0.0.0.0
PORT=5000

# ====================== 数据库配置 ======================
# 使用 compose 内置的 PostgreSQL；容器内通过服务名 db 访问
DB_HOST=db
DB_PORT=5432
DB_USER=bettafish
DB_PASSWORD=bettafish
DB_NAME=bettafish
DB_CHARSET=utf8mb4
DB_DIALECT=postgresql
# 宿主机访问数据库时使用的端口（psql -h 127.0.0.1 -p 5444）
POSTGRES_PORT=5444

# ====================== 本地大模型（Ollama） ======================
# 保留此行会随 compose 一起启动 Ollama 容器并自动拉取 LOCAL_LLM_MODEL；
# 如果你已在宿主机或其他服务器上运行 Ollama / vLLM / LM Studio，删除这一行，
# 并把下面所有 *_BASE_URL 改成对应地址（例如 http://host.docker.internal:11434/v1）
COMPOSE_PROFILES=ollama
LOCAL_LLM_MODEL=qwen3.8:27b
# Ollama 上下文长度，报告生成需要较长上下文；显存/内存不足时可调小
OLLAMA_CONTEXT_LENGTH=32768

# ======================= LLM 相关 =======================
# 所有 Agent 都走 OpenAI 兼容接口。Ollama 不校验 KEY，但代码要求非空，填任意值即可。
# 可以给不同 Agent 配不同模型，例如 Report Agent 用更大的模型，Keyword Optimizer 用小模型；
# 改用其他模型前先在 Ollama 中 pull：docker compose -f docker-compose.local.yml exec ollama ollama pull <模型名>
INSIGHT_ENGINE_API_KEY=ollama
INSIGHT_ENGINE_BASE_URL=http://ollama:11434/v1
INSIGHT_ENGINE_MODEL_NAME=qwen3.8:27b

MEDIA_ENGINE_API_KEY=ollama
MEDIA_ENGINE_BASE_URL=http://ollama:11434/v1
MEDIA_ENGINE_MODEL_NAME=qwen3.8:27b

QUERY_ENGINE_API_KEY=ollama
QUERY_ENGINE_BASE_URL=http://ollama:11434/v1
QUERY_ENGINE_MODEL_NAME=qwen3.8:27b

REPORT_ENGINE_API_KEY=ollama
REPORT_ENGINE_BASE_URL=http://ollama:11434/v1
REPORT_ENGINE_MODEL_NAME=qwen3.8:27b

MINDSPIDER_API_KEY=ollama
MINDSPIDER_BASE_URL=http://ollama:11434/v1
MINDSPIDER_MODEL_NAME=qwen3.8:27b

FORUM_HOST_API_KEY=ollama
FORUM_HOST_BASE_URL=http://ollama:11434/v1
FORUM_HOST_MODEL_NAME=qwen3.8:27b

KEYWORD_OPTIMIZER_API_KEY=ollama
KEYWORD_OPTIMIZER_BASE_URL=http://ollama:11434/v1
KEYWORD_OPTIMIZER_MODEL_NAME=qwen3.8:27b

# 报告生成时论坛讨论记录只保留最新的 N 个字符（0 为不限制）。
# 论坛记录往往有几十万字，每个章节都会整段送入模型，本地模型下会让单次调用长达十几分钟，甚至超出上下文
REPORT_FORUM_LOG_MAX_CHARS=30000

# ================== 网络搜索（本地 SearXNG） ====================
# SearXNG 会同时替代 Query Agent 的 Tavily 和 Media Agent 的 Bocha/Anspire，无需任何搜索 API Key
SEARCH_TOOL_TYPE=SearXNG
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=please-change-this-secret
SEARXNG_PORT=8888

# 以下云端搜索 API 在 SEARCH_TOOL_TYPE=SearXNG 时不会使用，留空即可
TAVILY_API_KEY=
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search
BOCHA_WEB_SEARCH_API_KEY=

# ================== 镜像构建 / 模型下载加速（可选） ====================
# 国内网络可改为 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple
# 国内网络可改为 https://hf-mirror.com（Insight Agent 首次运行会下载情感分析模型）
HF_ENDPOINT=https://huggingface.co
